# Copiar a .env y rellenar con valores reales.
# En GitHub Actions estos mismos nombres van como GitHub Secrets.

# --- Interruptor general del bot ---
# En false, los 5 jobs (sync_data, run_market, run_sales, set_lineup,
# manage_substitutes) hacen return inmediato sin tocar nada -- pausa
# rápida sin desactivar el `schedule:` de cada workflow de GitHub Actions
# uno a uno (ver README, "Activar el cron en GitHub Actions"). En GitHub,
# esto va como Variable (no Secret, no es sensible), así se puede cambiar
# desde la web sin tocar código.
ENABLE_BOT=true

# --- Futmondo ---
# No hay endpoint de login conocido (ver clients/futmondo_client.py): hay
# que iniciar sesión una vez en https://app.futmondo.com y copiar estos dos
# valores desde la consola del navegador (F12 -> Console):
#   localStorage.getItem("flutter.token")
#   localStorage.getItem("flutter.id_user")
FUTMONDO_TOKEN=
FUTMONDO_USER_ID=
# Id del campeonato (liga) y de tu equipo dentro de él. Se ven en el body
# de cualquier petición autenticada mientras navegas la app (DevTools ->
# Network -> cualquier POST a api.futmondo.com -> Payload -> query).
FUTMONDO_CHAMPIONSHIP_ID=
FUTMONDO_USERTEAM_ID=

# --- Telegram (notificaciones) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos ---
DATABASE_PATH=db/futmondo.db

# --- Alineaciones reales (Fotmob, opcional) ---
# Fotmob no exige API key ni cuenta -- solo activar el flag. Es una API no
# oficial sin contrato ni SLA (ver clients/football_lineups_client.py y
# README, sección "Banquillo/suplentes", para el porqué de esta fuente y
# sus TODOs pendientes).
ENABLE_REAL_LINEUP_CHECK=false

# --- Sustitución manual (jobs/manage_substitutes.py) ---
# Envía a Futmondo de verdad los cambios de sustitución decididos (ver
# engine.lineup_optimizer.build_substitution_changes()). Con esto en
# false, el job audita/notifica pero nunca aplica nada -- y, con el cron
# a cada 20 min, repite la misma notificación cada pasada mientras la
# situación no cambie de verdad en Futmondo (ver README, "Banquillo/
# suplentes"). La secuencia de las dos llamadas HTTP reales sigue sin
# probarse todavía con un caso real (lesión/rotación confirmada).
ENABLE_SUBSTITUTE_AUTO_SUBMIT=false

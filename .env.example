# Copiar a .env y rellenar con valores reales.
# En GitHub Actions estos mismos nombres van como GitHub Secrets.

# --- Comunio ---
COMUNIO_EMAIL=
COMUNIO_PASSWORD=
# Id de la liga privada (community) y de tu usuario dentro de ella. Se ven
# en las URLs de la API mientras navegas la app (DevTools -> Network), p.ej.
# /communities/{communityId}/users/{userId}/... De momento no hay endpoint
# confirmado que los devuelva solos tras el login.
COMUNIO_COMMUNITY_ID=
COMUNIO_USER_ID=

# --- Telegram (notificaciones) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos ---
DATABASE_PATH=db/comunio.db

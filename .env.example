# Copiar a .env y rellenar con valores reales.
# En GitHub Actions estos mismos nombres van como GitHub Secrets.

# --- Comunio ---
COMUNIO_EMAIL=
COMUNIO_PASSWORD=
# Id de la liga privada (community). Verlo en la URL de la app o en Ajustes
# de la liga; de momento no hay endpoint confirmado que lo devuelva solo.
COMUNIO_COMMUNITY_ID=

# --- Telegram (notificaciones) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos ---
DATABASE_PATH=db/comunio.db
